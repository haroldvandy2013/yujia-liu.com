---
import SiteHeader from '../components/SiteHeader.astro';
import { site, images } from '../config';
import { localUrl } from '../lib/urls';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  path: string;
}
const { title, description = site.tagline, path } = Astro.props;
const canonical = new URL(localUrl(path), Astro.site).href;
const pageTitle = `${title} - ${site.name}`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={localUrl(images.icon)} />
    <link rel="stylesheet" href={localUrl('fonts/fonts.css')} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <SiteHeader currentPath={path} />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>
