---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Content as Biography, frontmatter } from '../content/home.md';
import { Content as Contact } from '../content/contact.md';
import { localUrl, imageSrcset } from '../lib/urls';
---

<SiteLayout title={frontmatter.title} description={frontmatter.description} path="/">
  <div class="home-content">
    <div class="home-panel">
      <div class="home-biography"><Biography /></div>
      <img width="918" height="718" src={localUrl(frontmatter.photo)} alt={frontmatter.photoAlt}
        decoding="async" srcset={imageSrcset(frontmatter.photoSizes)}
        sizes="(max-width: 600px) 90vw, (max-width: 1060px) calc((100vw - 60px) * .37), 370px" />
    </div>
    <div class="contact-panel"><Contact /></div>
  </div>
</SiteLayout>
