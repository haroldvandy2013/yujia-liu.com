---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Content, frontmatter } from '../content/cv.md';
import { localUrl } from '../lib/urls';
---

<SiteLayout title={frontmatter.title} description={frontmatter.description} path="/cv/">
  <div class="cv-panel">
    <div class="cv-copy">
      <div class="cv-details">
        <h2 class="cv-title">{frontmatter.heading}</h2>
        <div>
          <a class="cv-download" href={localUrl(frontmatter.pdf)}><strong>{frontmatter.downloadLabel}</strong></a>
        </div>
        <Content />
      </div>
    </div>
    <img src={localUrl(frontmatter.photo)} alt={frontmatter.photoAlt} decoding="async" />
  </div>
</SiteLayout>
